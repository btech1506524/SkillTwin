# ====================================================
# SkillTwin AI — .gitignore
# CRITICAL: Never commit .env files — they contain secrets
# ====================================================

# Dependencies
node_modules/

# Environment variables — contains DB password & JWT secrets
.env
.env.local
.env.development
.env.production
.env.test

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Optional: lock files (remove if you want to commit them)
# package-lock.json
