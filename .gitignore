# ====================================================
# SkillTwin AI — .gitignore
# ====================================================

# Dependencies
node_modules/
*/node_modules/

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
backend/.env
server/.env
server_bak/.env

# Backups & temporary migrations
*_bak/
*.bak/
backup/
backups/

# Build and distribution output
dist/
dist-ssr/
build/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & IDE directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Testing & coverage
coverage/
.nyc_output/

# Optional: npm package lock files (uncomment if you don't track locks)
# package-lock.json
